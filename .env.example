# Optional overrides for docker compose.
#
# Runtime defaults are declared in docker-compose.yml. Notification channels,
# Apple Reminders / CalDAV, site settings and other business configuration are
# managed in the Web UI and do not belong in this file.
#
# Copy this file to .env only when you need to override a compose default:
# PORT=8906
# RATE_LIMIT=20
# DEVICE_TYPE=docker
# CORS_ORIGIN=*
# LOG_CONSOLE=false
# DISABLE_STATS=1
# STATS_ENDPOINT=
# REMINDER_DATA_KEY=
#
# Optional reminder-mcp profile variables (also read from .env):
# REMINDER_API_URL=http://kid941005-reminders:8906
# REMINDER_API_KEY=
# REMINDER_DEFAULT_CHANNELS=inapp
# REMINDER_TIMEZONE=Asia/Shanghai
# REMINDER_TIMEOUT=8
# MCP_ENDPOINT=
