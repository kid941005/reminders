# Copy this file to .env, fill in only the channels you need, then run make dev or docker compose up -d.
# Never commit the real .env file.

# Docker Compose runtime (optional).
# Set PORT here so the host mapping and container listener stay in sync.
# PORT=8906
# ENV=release

# Anonymous usage stats are disabled by default.
# DISABLE_STATS=0
# STATS_ENDPOINT=https://stats.example.com/report

# SMTP email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=your-account
# SMTP_PASSWORD=your-password-or-app-token
# SMTP_FROM_NAME=Reminder
# SMTP_FROM_ADDRESS=no-reply@example.com

# SMS provider webhook
# SMS_WEBHOOK_URL=https://sms-provider.example.com/send
# SMS_WEBHOOK_TOKEN=replace-me

# Feishu self-built app robot
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=replace-me
# FEISHU_BASE_URL=https://open.feishu.cn

# QQ bot
# QQ_BOT_APP_ID=replace-me
# QQ_BOT_APP_SECRET=replace-me
# QQ_BOT_API_BASE=https://api.bot.qq.com

# Runtime logs stay in <data-dir>/logs by default. Set true only for local debugging.
# LOG_CONSOLE=false

# --- Reminder MCP adapter (only used with docker compose --profile mcp) ---
# Uncomment and fill these when starting the reminder-mcp profile.
# REMINDER_API_URL=http://kid941005-reminders:8906
# REMINDER_API_KEY=replace-with-your-api-key
# REMINDER_DEFAULT_CHANNELS=inapp
# REMINDER_TIMEZONE=Asia/Shanghai
# REMINDER_TIMEOUT=8
# MCP_ENDPOINT=ws://192.168.50.100:38004/mcp_endpoint/mcp/?token=replace-with-your-token
