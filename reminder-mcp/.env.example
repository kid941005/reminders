# Reminder 服务地址。
# 用仓库根目录 docker-compose.yml 的 mcp profile 时保持服务名；
# 在本机直接运行 server.py 时改成 http://127.0.0.1:8906。
# 用 docker-compose.host.yml（host 网络）时改成 http://127.0.0.1:<PORT>，默认 8906。
REMINDER_API_URL=http://kid941005-reminders:8906

# Reminder「个人设置」页生成的 API Key（全权凭证，不要提交到 Git）
REMINDER_API_KEY=replace-with-your-api-key

# 新建待办默认推送渠道，逗号分隔；inapp=站内通知
REMINDER_DEFAULT_CHANNELS=inapp

# 时区，默认 Asia/Shanghai
REMINDER_TIMEZONE=Asia/Shanghai

# 调用 Reminder API 的超时秒数
REMINDER_TIMEOUT=8

# 小智 MCP 接入点地址（从智控台复制；mcp_pipe.py 会读取）
# 注意：如果 mcp-endpoint-server 与 Reminder 不在同一个 compose，
# 这里要填宿主机局域网 IP 和它映射出来的端口（例如 38004）。
MCP_ENDPOINT=ws://192.168.50.100:38004/mcp_endpoint/mcp/?token=replace-with-your-token
